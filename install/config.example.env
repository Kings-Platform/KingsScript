# KingsScript machine settings, loaded by every command. Lives in ~/.kingsScripts and is never
# committed. Everything is optional: uncomment only what differs from the default.

# git-swiftformatstaged: Swift version passed to SwiftFormat (default 5.9)
# KINGS_SWIFT_VERSION="5.9"

# slack-test: channel used when none is given
# KINGS_SLACK_CHANNEL="C0123456789"

# install-tabby: where apps go on machines without admin rights (default ~/Apps)
# KINGS_APPS_DIR="$HOME/Apps"

# graph: graph folder (default: graphify-out/ at the root of the current repo)
# KINGS_GRAPH_DIR="$HOME/Graphs/my-app/graphify-out"

# docs-check: docs root (default: current folder)
# KINGS_DOCS_ROOT="$HOME/Docs"

# fig-parse / fig-check: extracts, .fig files (figmas/) and fixtures (default ~/Documents/FigExtracts)
# KINGS_FIG_DIR="$HOME/Documents/FigExtracts"
